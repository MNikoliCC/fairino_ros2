<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fairino20_v6_robot">

  <xacro:arg name="initial_positions_file" default="initial_positions.yaml"/>
  <xacro:arg name="use_mock_hardware" default="false"/>
  <xacro:arg name="controller_ip" default="192.168.58.2"/>
  <xacro:arg name="allow_safety_config_writes" default="false"/>
  <xacro:arg name="servoj_cmd_period" default="0.001"/>
  <xacro:arg name="servoj_max_queue" default="8"/>

  <!-- Geometry + kinematic model. -->
  <xacro:include filename="$(find fairino_description)/urdf/fairino20_v6.urdf"/>

  <!-- ros2_control hardware declaration. -->
  <xacro:include filename="fairino20_v6_robot.ros2_control.xacro"/>

  <xacro:fairino20_v6_robot_ros2_control
    name="FairinoSystem"
    initial_positions_file="$(arg initial_positions_file)"
    use_mock_hardware="$(arg use_mock_hardware)"
    controller_ip="$(arg controller_ip)"
    allow_safety_config_writes="$(arg allow_safety_config_writes)"
    servoj_cmd_period="$(arg servoj_cmd_period)"
    servoj_max_queue="$(arg servoj_max_queue)"/>

</robot>
