<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fairino20_v6_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_mock_hardware" default="false" />

    <!-- Import fairino20_v6_robot urdf file -->
    <xacro:include filename="$(find fairino_description)/urdf/fairino20_v6.urdf" />

    <!-- Import ros2_control configuration -->
    <xacro:include filename="fairino20_v6_robot.ros2_control.xacro" />

    <xacro:fairino20_v6_robot_ros2_control
        name="FairinoSystem"
        initial_positions_file="$(arg initial_positions_file)"
        use_mock_hardware="$(arg use_mock_hardware)" />
</robot>
